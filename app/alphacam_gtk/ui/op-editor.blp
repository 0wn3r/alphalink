using Gtk 4.0;
using Adw 1;

// The operation editor pane (TOUCH.md 7.1); op_editor.py fills the scrolled part with rows made from the operation's
// fields. Delete Operation is a row at the bottom, next to Duplicate, so the title fits the header in touch mode.
template $AlphaLinkOpEditor: Box {
  orientation: vertical;
  width-request: 340;

  styles [
    "editor-pane",
  ]

  Adw.HeaderBar {
    show-end-title-buttons: false;
    show-start-title-buttons: false;
    show-back-button: false;

    title-widget: Adw.WindowTitle title {
      title: _("Operation");
    };

    [start]
    Button {
      icon-name: "go-up-symbolic";
      tooltip-text: _("Move Up");
      clicked => $_move_up();
    }

    [start]
    Button {
      icon-name: "go-down-symbolic";
      tooltip-text: _("Move Down");
      clicked => $_move_down();
    }

    [end]
    Button {
      icon-name: "window-close-symbolic";
      tooltip-text: _("Close Editor");
      clicked => $_close();
    }

  }

  ScrolledWindow scroll {
    vexpand: true;
    hscrollbar-policy: never;
  }
}
