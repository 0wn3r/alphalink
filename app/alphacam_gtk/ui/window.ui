                    <signal name="notify::collapsed" handler="_split_collapsed"/>
                    <property name="sidebar">
                      <object class="AdwNavigationPage">
                        <property name="title" translatable="yes">Operations</property>
                        <property name="child">
                          <object class="AdwToolbarView">
                            <child type="top">
                              <object class="AdwHeaderBar" id="side_header">
                                <child type="start">
