msgid "a line needs two different points"
msgstr "для лінії потрібні дві різні точки"

msgid "no element {gid}"
msgstr "немає елемента {gid}"

msgid "an arc of radius {r} cannot join X{ax} Z{az} and X{bx} Z{bz}"
msgstr "дуга радіуса {r} не може з’єднати X{ax} Z{az} і X{bx} Z{bz}"

msgid "{gid} would have no length"
msgstr "{gid} мав би нульову довжину"

msgid "X{x} Z{z} is not a corner between two lines"
msgstr "X{x} Z{z} — не кут між двома лініями"

msgid "radius must be > 0"
msgstr "радіус має бути > 0"

msgid "the lines are parallel at this point"
msgstr "у цій точці лінії паралельні"

msgid "radius {radius} is too large for these lines"
msgstr "радіус {radius} завеликий для цих ліній"

msgid "chamfer size must be > 0"
msgstr "розмір фаски має бути > 0"

msgid "chamfer angle must be between 0 and 90 degrees"
msgstr "кут фаски має бути між 0 і 90 градусами"

msgid "a {angle} degree chamfer does not fit this corner"
msgstr "фаска під {angle}° не вміщується в цей кут"

msgid "chamfer {size} x {angle} deg is too large for these lines"
msgstr "фаска {size} × {angle}° завелика для цих ліній"

msgid "{id} does not connect to the picked contour"
msgstr "{id} не з’єднується з вибраним контуром"

msgid "the three points are on a line"
msgstr "три точки лежать на одній прямій"

msgid "pick two different lines"
msgstr "виберіть дві різні лінії"

msgid "the lines are parallel"
msgstr "лінії паралельні"

msgid "a line would shrink to a point"
msgstr "лінія зменшилася б до точки"

msgid "no text"
msgstr "немає тексту"

msgid "pick an arc"
msgstr "виберіть дугу"

msgid "pick a line"
msgstr "виберіть лінію"

msgid "the point is inside the arc"
msgstr "точка всередині дуги"

msgid "the arcs have the same centre"
msgstr "дуги мають спільний центр"

msgid "distance must be > 0"
msgstr "відстань має бути > 0"

msgid "the point is not inside the arc"
msgstr "точка не лежить на дузі"

msgid "nothing to mirror"
msgstr "немає чого відображати"

msgid "no blend arc touches this arc there"
msgstr "дуга сполучення не торкається цієї дуги в цьому місці"

msgid "G71 E{e} (area clear option) is not supported yet"
msgstr "G71 E{e} (параметр чорнової обробки) поки не підтримується"

msgid "threading: the thread lines are not in the drawing"
msgstr "різьба: ліній різьби немає на кресленні"

msgid "SDG too short ({len_data} bytes)"
msgstr "файл SDG закороткий ({len_data} байт)"

msgid "the drawing has too many points for ALPHA-T ({n} > {max})"
msgstr "у кресленні забагато точок для ALPHA-T ({n} > {max})"

msgid "the drawing has too many elements for ALPHA-T ({n} > 255)"
msgstr "у кресленні забагато елементів для ALPHA-T ({n} > 255)"

msgid "the drawing has too many elements for ALPHA-T"
msgstr "у кресленні забагато елементів для ALPHA-T"

msgid "not a TL1 tool library ({len_data} bytes)"
msgstr "це не бібліотека інструментів TL1 ({len_data} байт)"

msgid "nothing received"
msgstr "нічого не отримано"

msgid "transfer stopped after {n} bytes (no second %)"
msgstr "передача зупинилася після {n} байт (немає другого %)"

msgid "contour references unknown geometry: {join_missing}"
msgstr "контур посилається на невідомі елементи: {join_missing}"

msgid "thread pitch must be > 0"
msgstr "крок різьби має бути > 0"

msgid "units must be one of {units}, not {units2}"
msgstr "одиниці мають бути одним із {units}, а не {units2}"

msgid "not an AlphaLink CAM part (format {fmt}, expected {expected})"
msgstr "це не деталь AlphaLink CAM (формат {fmt}, очікувався {expected})"

msgid "unknown element or operation type {type}"
msgstr "невідомий тип елемента чи операції {type}"

msgid "{what}: unknown keys {keys}"
msgstr "{what}: невідомі ключі {keys}"

msgid "unknown tool type {type}"
msgstr "невідомий тип інструмента {type}"

msgid "tool hand must be R, L or N, not {hand}"
msgstr "виконання інструмента має бути R, L або N, а не {hand}"

msgid "no tool {number}"
msgstr "немає інструмента {number}"

msgid "unsupported tool library format {get_format}"
msgstr "непідтримуваний формат бібліотеки інструментів {get_format}"

msgid "{value} moves are not supported by the post yet"
msgstr "переміщення {value} постпроцесор поки не підтримує"

msgid "{op}: no cuts with this contour (nothing between the tool start and the profile)"
msgstr "{op}: з цим контуром немає проходів (між початковою точкою і профілем нічого немає)"

msgid "area clear FACE with pre-finish (no sample)"
msgstr "чорнова обробка по торцю з напівчистовим проходом (немає зразка ALPHA-T)"

msgid "{type} is not supported by the post yet"
msgstr "{type} постпроцесор поки не підтримує"

msgid "move/dwell before the first tool change is not supported"
msgstr "переміщення чи витримка до першої зміни інструмента не підтримуються"

msgid "{type} is not supported by the SD1 writer yet"
msgstr "{type} поки не записується у файл SD1"

msgid "area clear: no contour below X{x}"
msgstr "чорнова обробка: немає контуру нижче X{x}"

msgid "area clear AWAY: ALPHA-T itself cuts 1.6 mm past the shoulder for it, so the app does not offer it; use TOWARDS"
msgstr "чорнова обробка AWAY: сама ALPHA-T у цьому режимі заходить на 1,6 мм за уступ, тому програма його не пропонує; використовуйте «До патрона»"

msgid "depth of cut must be > 0"
msgstr "глибина різання має бути > 0"

msgid "area clear"
msgstr "чорнова обробка"

msgid "empty contour"
msgstr "порожній контур"

msgid "contour is not connected at X{x} Z{z} ({id})"
msgstr "контур розірваний у X{x} Z{z} ({id})"

msgid "arc-to-arc corners are not supported yet"
msgstr "кути між двома дугами поки не підтримуються"

msgid "drill depth must be below the start Z"
msgstr "дно отвору має бути нижче початкового Z"

msgid "retract distance must be > 0"
msgstr "відстань відведення має бути > 0"

msgid "face clear: no profile at Z{z}"
msgstr "обробка торця: немає профілю на Z{z}"

msgid "face clear AWAY: ALPHA-T itself writes only one pass at Z0 for it, so the app does not offer it; use TOWARDS"
msgstr "обробка торця AWAY: сама ALPHA-T у цьому режимі пише лише один прохід на Z0, тому програма його не пропонує; використовуйте «До патрона»"

msgid "face clear"
msgstr "обробка торця"

msgid "grooving: no profile under Z{z0}..{z1}"
msgstr "канавка: немає профілю під Z{z0}..{z1}"

msgid "grooving finish offsets: only faces and diameters (no sample with slopes/arcs)"
msgstr "чистовий припуск канавки: лише торці й діаметри (немає зразка з похилими лініями чи дугами)"

msgid "grooving finish mode: only external, no finish offsets (no sample)"
msgstr "чистовий режим канавки: лише зовнішня, без чистового припуску (немає зразка)"

msgid "internal grooving with pecking (no sample)"
msgstr "внутрішня канавка з врізанням кроками (немає зразка)"

msgid "grooving"
msgstr "точіння канавок"

msgid "face grooving: no profile under X{x0}..{x1}"
msgstr "торцеві канавки: немає профілю під X{x0}..{x1}"

msgid "face grooving: only external, area mode, without pecks, X shift or finish offsets (no sample)"
msgstr "торцеві канавки: лише зовнішні, режим area, без кроків врізання, зсуву X і чистових припусків (немає зразка)"

msgid "face grooving"
msgstr "торцеві канавки"

msgid "grooving finish: lines only (no sample with arcs)"
msgstr "чистовий режим канавки: лише лінії (немає зразка з дугами)"

msgid "threading AWAY: ALPHA-T itself starts every cut inside the thread for it, so the app does not offer it; use TOWARDS"
msgstr "різьба AWAY: сама ALPHA-T у цьому режимі починає кожен прохід усередині різьби, тому програма його не пропонує; використовуйте «До патрона»"

msgid "thread lines must be parallel to Z"
msgstr "лінії різьби мають бути паралельні Z"

msgid "thread: outer diameter must be above the inner one, first cut > 0"
msgstr "різьба: зовнішній діаметр має бути більший за внутрішній, перший прохід > 0"

msgid "threading: {n} cuts; make the first cut deeper or set fewer cuts (at most {max})"
msgstr "різьба: {n} проходів; зробіть перший прохід глибшим або задайте менше проходів (не більше {max})"

msgid "{what}: more than {max} passes; check the depth of cut / stepover"
msgstr "{what}: понад {max} проходів; перевірте глибину різання / крок"

msgid "Lathe CAM for the Harrison Alpha 400T, writing ALPHA-T programs."
msgstr "CAM для токарного верстата Harrison Alpha 400T, що створює програми ALPHA-T."

msgid "translator-credits"
msgstr "Claude (переклад), Eduard (перевірка)"

msgid "Circle…"
msgstr "Коло…"

msgid "Tangent"
msgstr "Дотична"

msgid "Tangent at an Angle…"
msgstr "Дотична під кутом…"

msgid "Blend Arc… (O)"
msgstr "Дуга сполучення… (O)"

msgid "Parallel Line…"
msgstr "Паралельна лінія…"

msgid "Split Arc"
msgstr "Розділити дугу"

msgid "Mirror Image"
msgstr "Дзеркальне відображення"

msgid "Arc"
msgstr "Дуга"

msgid "Fillet"
msgstr "Скруглення"

msgid "Line"
msgstr "Лінія"

msgid "Select"
msgstr "Вибір"

msgid "Chamfer"
msgstr "Фаска"

msgid "Corner"
msgstr "Кут"

msgid "Select an element or an operation. L / A: select the nearest line / arc"
msgstr "Вибрати елемент або операцію. L / A: вибрати найближчу лінію / дугу"

msgid "Draw lines. X: type X,Z   D: length,angle   +: by taps   S: start at the cursor"
msgstr "Креслити лінії. X: ввести X,Z   D: довжина,кут   +: дотиками   S: почати від курсора"

msgid "Draw an arc: start, a point on the arc, end (W)"
msgstr "Креслити дугу: початок, точка на дузі, кінець (W)"

msgid "Round a corner. F: radius at the corner nearest the cursor"
msgstr "Скруглити кут. F: радіус на куті, найближчому до курсора"

msgid "Chamfer a corner (B)"
msgstr "Зняти фаску на куті (B)"

msgid "Trim or extend two lines to meet (K)"
msgstr "Обрізати або подовжити дві лінії до перетину (K)"

msgid "X,Z  or  @dX,dZ  then Enter (line tool)"
msgstr "X,Z  або  @dX,dZ  і Enter (інструмент «Лінія»)"

msgid "Draw line: length,angle  then Enter (0° = towards -Z, 90° = +X)"
msgstr "Лінія: довжина,кут  і Enter (0° — у бік -Z, 90° — у бік +X)"

msgid "Move the cursor to X,Z  then Enter"
msgstr "Перемістити курсор у X,Z  і Enter"

msgid "Move the cursor by dX,dZ  then Enter"
msgstr "Перемістити курсор на dX,dZ  і Enter"

msgid "Move the cursor by length,angle  then Enter (0° = towards -Z, 90° = +X)"
msgstr "Перемістити курсор на довжину,кут  і Enter (0° — у бік -Z, 90° — у бік +X)"

msgid "_Done"
msgstr "_Готово"

msgid "Finish the line (Esc)"
msgstr "Завершити лінію (Esc)"

msgid "Delete Element (Del or -)"
msgstr "Видалити елемент (Del або -)"

msgid "Edit Element (E)"
msgstr "Редагувати елемент (E)"

msgid "Keypad"
msgstr "Цифрова клавіатура"

msgid "More"
msgstr "Ще"

msgid "More drawing commands"
msgstr "Інші команди креслення"

msgid "_Cancel"
msgstr "_Скасувати"

msgid "Tap the contour elements in cutting order"
msgstr "Торкніться елементів контуру в порядку обробки"

msgid "Tap a corner between two lines"
msgstr "Торкніться кута між двома лініями"

msgid "Command aborted"
msgstr "Команду скасовано"

msgid "No intersection to find"
msgstr "Немає перетину, який можна знайти"

msgid "No point to find"
msgstr "Немає точки, яку можна знайти"

msgid "No arc to find"
msgstr "Немає дуги, яку можна знайти"

msgid "No line to find"
msgstr "Немає лінії, яку можна знайти"

msgid "{what} found: - or Delete erases it"
msgstr "Знайдено {what}: - або Delete стирає"

msgid "Select a line or arc first (L / A finds the nearest)"
msgstr "Спершу виберіть лінію чи дугу (L / A знаходить найближчу)"

msgid "No text to erase"
msgstr "Немає тексту, який можна стерти"

msgid "Erase text"
msgstr "Стерти текст"

msgid "Cursor step {step}"
msgstr "Крок курсора {step}"

msgid "Measure: tap the 1st point, or move the cursor and press Enter"
msgstr "Вимірювання: торкніться 1-ї точки або поставте курсор і натисніть Enter"

msgid "Measure: now the 2nd point"
msgstr "Вимірювання: тепер 2-га точка"

msgid "At X{x} Z{z}"
msgstr "У точці X{x} Z{z}"

msgid "Text"
msgstr "Текст"

msgid "Height"
msgstr "Висота"

msgid "_Add"
msgstr "_Додати"

msgid "Erase All of the Drawing?"
msgstr "Стерти все креслення?"

msgid "Lines, arcs and text are erased. Operations stay, without their contours. Undo brings the drawing back."
msgstr "Лінії, дуги й текст буде стерто. Операції залишаться, але без контурів. Скасування повертає креслення."

msgid "_Erase"
msgstr "_Стерти"

msgid "Erase drawing"
msgstr "Стерти креслення"

msgid "Draw line"
msgstr "Накреслити лінію"

msgid "Arc: now a point on the arc"
msgstr "Дуга: тепер точка на дузі"

msgid "Arc: now the end point"
msgstr "Дуга: тепер кінцева точка"

msgid "Draw arc"
msgstr "Накреслити дугу"

msgid "Corner: now tap the second line"
msgstr "Кут: тепер торкніться другої лінії"

msgid "Type X,Z (diameter, Z) or @dX,dZ"
msgstr "Введіть X,Z (діаметр, Z) або @dX,dZ"

msgid "@ needs a previous point"
msgstr "Для @ потрібна попередня точка"

msgid "Next Point"
msgstr "Наступна точка"

msgid "Start Point"
msgstr "Початкова точка"

msgid "Delete {what}"
msgstr "Видалити {what}"

msgid "Deleted {what}"
msgstr "Видалено: {what}"

msgid "_Undo"
msgstr "_Скасувати"

msgid "Edit {what}"
msgstr "Редагувати {what}"

msgid "End points as X (diameter), Z."
msgstr "Кінцеві точки як X (діаметр), Z."

msgid "End X"
msgstr "Кінець X"

msgid "End Z"
msgstr "Кінець Z"

msgid "Start X"
msgstr "Початок X"

msgid "Start Z"
msgstr "Початок Z"

msgid "Radius"
msgstr "Радіус"

msgid "Move connected ends too"
msgstr "Переміщати й з’єднані кінці"

msgid "keeps the profile joined"
msgstr "профіль залишається з’єднаним"

msgid "_Apply"
msgstr "_Застосувати"

msgid "Chamfer at {point}"
msgstr "Фаска в {point}"

msgid "Radius at {point}"
msgstr "Радіус у {point}"

msgid "Angle"
msgstr "Кут"

msgid "Between the chamfer and the line along Z; the size is measured along that line"
msgstr "Між фаскою та лінією вздовж Z; розмір вимірюється вздовж цієї лінії"

msgid "Fillet R{size}"
msgstr "Скруглення R{size}"

msgid "Chamfer {size}"
msgstr "Фаска {size}"

msgid "{n} picked — tap again to remove, then Done"
msgid_plural "{n} picked — tap again to remove, then Done"
msgstr[0] "Вибрано {n} — торкніться ще раз, щоб прибрати, потім «Готово»"
msgstr[1] "Вибрано {n} — торкніться ще раз, щоб прибрати, потім «Готово»"
msgstr[2] "Вибрано {n} — торкніться ще раз, щоб прибрати, потім «Готово»"

msgid "Pick contour"
msgstr "Вибір контуру"

msgid "Centre X (Ø)"
msgstr "Центр X (Ø)"

msgid "Centre Z"
msgstr "Центр Z"

msgid "Circle"
msgstr "Коло"

msgid "Tangent at an angle: tap the arc"
msgstr "Дотична під кутом: торкніться дуги"

msgid "Tangent: tap a point, or an arc"
msgstr "Дотична: торкніться точки або дуги"

msgid "Parallel line: tap the line"
msgstr "Паралельна лінія: торкніться лінії"

msgid "Split arc: tap the arc where to split it"
msgstr "Розділити дугу: торкніться дуги там, де розділити"

msgid "Blend arc: tap the 1st point, line or arc"
msgstr "Дуга сполучення: торкніться 1-ї точки, лінії або дуги"

msgid "Is this correct?"
msgstr "Чи це правильно?"

msgid "The drawing is mirrored about the spindle axis."
msgstr "Креслення дзеркально відображено відносно осі шпинделя."

msgid "_No"
msgstr "_Ні"

msgid "_Yes"
msgstr "_Так"

msgid "No solution for these elements"
msgstr "Для цих елементів розв’язку немає"

msgid "Tap the one you want (dashed)"
msgstr "Торкніться потрібного варіанта (пунктир)"

msgid "Tap an arc"
msgstr "Торкніться дуги"

msgid "Split arc"
msgstr "Розділити дугу"

msgid "Tap a line"
msgstr "Торкніться лінії"

msgid "Distance"
msgstr "Відстань"

msgid "Parallel Line"
msgstr "Паралельна лінія"

msgid "Parallel line"
msgstr "Паралельна лінія"

msgid "Tangent at an Angle"
msgstr "Дотична під кутом"

msgid "Tap a point or an arc"
msgstr "Торкніться точки або дуги"

msgid "Tangent: now tap the arc"
msgstr "Дотична: тепер торкніться дуги"

msgid "Blend arc: now the 2nd point, line or arc"
msgstr "Дуга сполучення: тепер 2-а точка, лінія або дуга"

msgid "Blend arc"
msgstr "Дуга сполучення"

msgid "Blend Arc"
msgstr "Дуга сполучення"

msgid "Could not open the manual: {error}"
msgstr "Не вдалося відкрити посібник: {error}"

msgid "Help"
msgstr "Довідка"

msgid "Hold to start"
msgstr "Утримуйте, щоб почати"

msgid "Point"
msgstr "Точка"

msgid "ABS"
msgstr "АБС"

msgid "INC"
msgstr "ПРИР"

msgid "On the lathe: CAM key, 4 “LOAD CAM FILE”, then touch the ← arrow. Then hold “Send to the Lathe” here."
msgstr "На верстаті: клавіша CAM, 4 «LOAD CAM FILE», потім торкніться стрілки ←. Тоді утримуйте тут «Надіслати на верстат»."

msgid "Start the backup here first, then on the lathe: in Manual Ops touch the ops file icon, 1 “OP. SAVE/RESTORE”, then the → arrow."
msgstr "Спершу запустіть резервне копіювання тут, потім на верстаті: у Manual Ops торкніться значка файлу операцій, 1 «OP. SAVE/RESTORE», потім стрілки →."

msgid "On the lathe: in Manual Ops touch the ops file icon, 1 “OP. SAVE/RESTORE”, then the ← arrow. Only Manual Ops files saved from this lathe: programs not made for the Alpha-T can corrupt its macros (Alphalink-T manual)."
msgstr "На верстаті: у Manual Ops торкніться значка файлу операцій, 1 «OP. SAVE/RESTORE», потім стрілки ←. Лише файли Manual Ops, збережені з цього верстата: програми, створені не для Alpha-T, можуть пошкодити його макроси (посібник Alphalink-T)."

msgid "Unplug the cable from the lathe and bridge pins 2 and 3 of the adapter, then run the test."
msgstr "Від’єднайте кабель від верстата й з’єднайте контакти 2 і 3 адаптера, потім запустіть перевірку."

msgid "Opening port…"
msgstr "Відкриття порту…"

msgid "Cancelling…"
msgstr "Скасування…"

msgid "_Close"
msgstr "_Закрити"

msgid "Connection"
msgstr "З’єднання"

msgid "Serial port"
msgstr "Послідовний порт"

msgid "Rescan Ports"
msgstr "Оновити список портів"

msgid "Modem lines"
msgstr "Лінії модему"

