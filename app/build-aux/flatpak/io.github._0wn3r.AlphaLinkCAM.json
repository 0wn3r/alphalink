{
  "id": "io.github._0wn3r.AlphaLinkCAM",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "alphalink-cam",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=all",
    "--allow=bluetooth",
    "--system-talk-name=org.bluez",
    "--filesystem=home",
    "--filesystem=/media",
    "--filesystem=/run/media"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "*.la"
  ],
  "modules": [
    {
      "name": "python3-pyserial",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --verbose --exists-action=i --no-index --no-build-isolation --prefix=${FLATPAK_DEST} ."
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://files.pythonhosted.org/packages/source/p/pyserial/pyserial-3.5.tar.gz",
          "sha256": "3c77e014170dfffbd816e6ffc205e9842efb10be9f58ec16d3e8675b4925cddb"
        }
      ]
    },
    {
      "name": "python3-ezdxf",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --verbose --exists-action=i --no-index --find-links=file://${PWD} --prefix=${FLATPAK_DEST} --no-build-isolation ezdxf"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/a0/09/5ecb6f82d35a2f4a4334d0a608fcf764827fa69dccdf5987ce309c16b6c1/ezdxf-1.4.4-py3-none-any.whl",
          "sha256": "666edda631ba717270293b734f5d58dd97a1d1aba4787187f09d0cc584645865"
        },
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/38/bb/d215ee7c73b61497b28a5503f9f53523f294fcc936762b7caf90e0c1c2b5/pyparsing-3.3.3-py3-none-any.whl",
          "sha256": "ece8c00a69cf01b45d0b1dedabb469c90d8caf996d4fda40f147627a122849a4"
        },
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/49/d3/b8441a820a491ddfc024b0b0cf0393375b75ea13866d9c66727e54c2fc80/typing_extensions-4.16.0-py3-none-any.whl",
          "sha256": "481caa481374e813c1b176ada14e97f1f67a4539ce9cfeb3f350d78d6370c2e8"
        },
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/3d/61/4161946319472aaa9b897bd18ad5108a5b10f5ebaa503d921a001ac4fff9/fonttools-4.67.0-py3-none-any.whl",
          "sha256": "4304f03ed7f4ba000a8dcc941ad854bfa52e2f3b6112b8f099b6f431cf98e701"
        },
        {
          "type": "file",
          "only-arches": ["x86_64"],
          "url": "https://files.pythonhosted.org/packages/16/d5/928078d2b28f26829b138b4a6c3980045022fb409f570657a224ae60ef4e/numpy-2.5.4-cp314-cp314-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl",
          "sha256": "d549420b8858885cea8838a727842249218b9c1da24dd517e25c9c7a948310a3"
        },
        {
          "type": "file",
          "only-arches": ["aarch64"],
          "url": "https://files.pythonhosted.org/packages/63/d6/34b0a2b0741386a63025a65a2c09caaaaaad6d0ca95b66cd65c30dd7fcb5/numpy-2.5.4-cp314-cp314-manylinux_2_27_aarch64.manylinux_2_28_aarch64.whl",
          "sha256": "4054173604cd8658796053f1f3bc0befb68ec1c0762c57fdad61e199256a8617"
        }
      ]
    },
    {
      "name": "alphalink-cam",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --verbose --no-deps --no-index --no-build-isolation --prefix=${FLATPAK_DEST} ./app",
        "install -Dm644 app/data/io.github._0wn3r.AlphaLinkCAM.desktop -t ${FLATPAK_DEST}/share/applications",
        "install -Dm644 app/data/io.github._0wn3r.AlphaLinkCAM.metainfo.xml -t ${FLATPAK_DEST}/share/metainfo",
        "install -Dm644 app/data/icons/hicolor/scalable/apps/io.github._0wn3r.AlphaLinkCAM.svg -t ${FLATPAK_DEST}/share/icons/hicolor/scalable/apps",
        "install -Dm644 app/examples/*.alcam -t ${FLATPAK_DEST}/share/alphalink-cam/examples"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../../..",
          "skip": [
            ".git",
            "app/e2e-out",
            "docs",
            "evidence",
            "tools",
            "vendor-config",
            "_to_delete"
          ]
        }
      ],
      "run-tests": true,
      "test-commands": [
        "cd app && env -u DISPLAY -u WAYLAND_DISPLAY python3 -m unittest discover -s tests -t ."
      ]
    }
  ]
}
