{
  "id": "io.github._0wn3r.AlphaLinkCAM",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "alphalink-cam",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=all"
  ],
  "cleanup": ["/include", "/lib/pkgconfig", "*.la"],
  "modules": [
    {
      "name": "python3-pyserial",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --verbose --exists-action=i --no-index --no-build-isolation --prefix=${FLATPAK_DEST} ."
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://files.pythonhosted.org/packages/source/p/pyserial/pyserial-3.5.tar.gz",
          "sha256": "3c77e014170dfffbd816e6ffc205e9842efb10be9f58ec16d3e8675b4925cddb"
        }
      ]
    },
    {
      "name": "alphalink-cam",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --verbose --no-deps --no-index --no-build-isolation --prefix=${FLATPAK_DEST} .",
        "install -Dm644 data/io.github._0wn3r.AlphaLinkCAM.desktop -t ${FLATPAK_DEST}/share/applications",
        "install -Dm644 data/io.github._0wn3r.AlphaLinkCAM.metainfo.xml -t ${FLATPAK_DEST}/share/metainfo",
        "install -Dm644 data/icons/hicolor/scalable/apps/io.github._0wn3r.AlphaLinkCAM.svg -t ${FLATPAK_DEST}/share/icons/hicolor/scalable/apps",
        "install -Dm644 examples/*.alcam -t ${FLATPAK_DEST}/share/alphalink-cam/examples"
      ],
      "sources": [
        {"type": "dir", "path": "../.."}
      ]
    }
  ]
}
