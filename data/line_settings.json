{
 "_note": "Measured in DOSBox-X serial log (New COM parameters) unless 'source' says otherwise. XON=0x11.",
 "dos_alphacam_v181": {
  "ALINK send .600": {
   "baud": 9600,
   "bits": 8,
   "parity": "E",
   "stop": 2,
   "xon": "0x11",
   "xoff": "0x93 (only)",
   "transform": "LF dropped",
   "source": "DOSBox 0.74 + DOSBox-X"
  },
  "AMANOPS LOAD (send .MOP)": {
   "baud": 9600,
   "bits": 7,
   "parity": "E",
   "stop": 2,
   "xoff": "0x93 (only)",
   "transform": "even parity in bit 7, >0x7F->0x00"
  },
  "AMANOPS SAVE (receive .MOP)": {
   "baud": 9600,
   "bits": 8,
   "parity": "E",
   "stop": 2,
   "end": "second '%'"
  }
 },
 "dos_alphalink_t_v12": {
  "ATSEND send .PRG": {
   "baud": 9600,
   "bits": 7,
   "parity": "E",
   "stop": 2,
   "xon": "0x11",
   "xoff": "0x13",
   "transform": "none (CR LF kept)"
  },
  "ATMANOP Save (receive .MOP)": {
   "baud": 9600,
   "bits": 7,
   "parity": "E",
   "stop": 2,
