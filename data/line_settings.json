  }
 },
 "win_serioalpha_v11_and_alphautils": {
  "CAM Progs Send001 (*.FAN)": {
   "baud": 9600,
   "bits": 7,
   "parity": "E",
   "stop": 2,
   "handshake": "XON/XOFF",
